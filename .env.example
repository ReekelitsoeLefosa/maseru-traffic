# ---- Detection ----
YOLO_MODEL=yolov8n.pt          # or models/maseru_best.pt after custom training
DETECT_CONF=0.2
DETECT_IMGSZ=960              # 960+ for wide views with small, distant vehicles
FRAME_STRIDE=2                 # process every 2nd frame (raise on slow CPUs)
MINIBUS_HEURISTIC=true

# ---- Analytics ----
WINDOW_SECONDS=300             # 5-minute counting windows
SIMULATE_OTHER_INTERSECTIONS=true

# ---- Notifications: console | twilio | meta ----
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
ALERT_COOLDOWN_SECONDS=900
DEFAULT_COUNTRY_CODE=266

# Twilio (SMS + WhatsApp) - https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API - https://developers.facebook.com/docs/whatsapp/cloud-api
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=maseru-traffic-verify

# ---- App access ----
# Admin key for using admin features from another device: open https://your-link/?admin=THIS-KEY once.
# Leave empty to allow admin only on the PC running the Windows app.
ADMIN_TOKEN=
# Permanent https address for phones (leave empty when using the Windows app's automatic link).
PUBLIC_URL=
# Set to false to stop the Windows app from opening a public https link even if cloudflared is present.
SHARE_ONLINE=true
