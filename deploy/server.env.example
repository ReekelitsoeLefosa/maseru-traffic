# ---- Cloud server settings (copy to .env next to docker-compose.yml) ----

# Your address. No domain yet? Use your server's IP with dashes + .sslip.io, e.g. for IP 203.0.113.7:
#   DOMAIN=203-0-113-7.sslip.io
DOMAIN=
# The same address with https:// in front, e.g. https://203-0-113-7.sslip.io
PUBLIC_URL=

# Secret shared with camera stations (generate a long random string; put the same on the station PC).
STATION_KEY=
# Admin key: open https://YOUR-DOMAIN/?admin=THIS-KEY once on your own phone/PC to unlock admin features.
ADMIN_TOKEN=

# Junctions without a camera station show simulated traffic (set false once all junctions have cameras).
SIMULATE_OTHER_INTERSECTIONS=true
WINDOW_SECONDS=300

# Push notifications (Android/iOS apps): path to the Firebase service-account key inside the container.
FCM_CREDENTIALS=/app/data/firebase-service-account.json

# SMS / WhatsApp (optional): console | twilio | meta
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=maseru-traffic-verify
